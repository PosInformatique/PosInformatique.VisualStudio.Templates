<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <VisualStudioSdkBuildToolsVersion>18.5.40034</VisualStudioSdkBuildToolsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="editorconfig" Version="0.18.0" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="$(VisualStudioSdkBuildToolsVersion)" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.1-beta" />
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
    <PackageVersion Include="xunit.v3.core.mtp-v2" Version="4.0.2" />
  </ItemGroup>
</Project>
