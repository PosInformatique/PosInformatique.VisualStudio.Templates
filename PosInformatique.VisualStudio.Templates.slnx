<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="arm64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="LICENSE" />
    <File Path="README.md" />
    <File Path="stylecop.json" />
    <File Path="VisualStudio.Templates.package.proj" />
  </Folder>
  <Folder Name="/Solution Items/build/">
    <File Path="build/azure-pipelines-release.yaml" />
  </Folder>
  <Project Path="src/VisualStudio.Templates.Files/VisualStudio.Templates.Files.csproj">
    <Platform Solution="*|arm64" Project="arm64" />
    <Platform Solution="*|x86" Project="x86" />
  </Project>
  <Project Path="src/VisualStudio.Templates/VisualStudio.Templates.csproj">
    <Platform Solution="*|arm64" Project="arm64" />
    <Platform Solution="*|x86" Project="x86" />
    <Deploy Solution="*|Any CPU" />
  </Project>
  <Project Path="tests/VisualStudio.Templates.UnitTests/VisualStudio.Templates.UnitTests.csproj" />
</Solution>
